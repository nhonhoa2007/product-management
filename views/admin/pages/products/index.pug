extends ../../layouts/default.pug
include ../../mixins/filter-status.pug
include ../../mixins/search.pug
include ../../mixins/pagination.pug

block main
    h1.mb-4 #{pageTitle}

    //- Card: Bộ lọc và Tìm kiếm
    .card.mb-3
        .card-header Bộ lọc và Tìm kiếm
        .card-body
            .row
                .col-6
                    +filter-status(filterStatus)

                .col-6
                    +search(keyword)

    //- Card: Danh sách sản phẩm
    .card.mb-3
        .card-header.d-flex.align-items-center.justify-content-between
            span.font-weight-bold Danh sách sản phẩm
            a(
                href=`${prefixAdmin}/products/create`,
                class="btn btn-outline-success btn-sm"
            ) + Thêm mới

        .card-body
            table.table.table-hover.table-sm
                thead
                    tr
                        th STT
                        th Hình ảnh
                        th Tiêu đề
                        th Giá
                        th Vị trí
                        th Trạng thái
                        th Hành động

                tbody
                    if (products && products.length > 0)
                        each item, index in products
                            tr
                                td #{index + 1}
                                td
                                    img(
                                        src=item.thumbnail,
                                        alt=item.title,
                                        width="100px",
                                        height="auto"
                                    )
                                td #{item.title}
                                td $#{item.price}
                                td
                                    input(
                                        type="number",
                                        value=item.position,
                                        style="width: 60px",
                                        min="1",
                                        name="position"
                                    )
                                td
                                    if (item.status === "active")
                                        a(href="javascript:;", class="badge badge-success") Hoạt động
                                    else
                                        a(href="javascript:;", class="badge badge-danger") Dừng hoạt động
                                td
                                    button(class="btn btn-warning btn-sm mr-1") Sửa
                                    button(class="btn btn-danger btn-sm") Xóa

    //- Phân trang tự động
    +pagination(pagination)